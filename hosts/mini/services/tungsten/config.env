# Non-secret settings for tungsten on the Mac mini. Loaded after Infisical's secrets, so these win.
# $SERVICE_DATA is ~/.homelab/services/tungsten/data.
ENVIRONMENT=production
PORT=3002
TUNGSTEN_ROLE=all

# Local Redis (from the Brewfile) for tungsten's internal queues. Overrides the cluster URL in Infisical.
REDIS_URL=redis://localhost:6379

FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
WHISPER_MODELS_DIR=$SERVICE_DATA/models
# Callers may request these; the first is the default. Every entry must be in models.txt.
# Benchmarked on this mini (M4, Metal, Sep 2026) for a 3s clip: base.en-q8_0 0.19s,
# small.en-q8_0 0.36s, large-v3-turbo-q8_0 1.2s.
WHISPER_MODELS=small.en-q8_0,base.en-q8_0,large-v3-turbo-q8_0
# whisper runs on the GPU, so CPU threads matter less; the M4 has 4 performance cores.
WHISPER_THREADS_INTERACTIVE=4
WHISPER_THREADS_BATCH=4
