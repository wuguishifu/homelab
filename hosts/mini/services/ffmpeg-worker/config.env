# Non-secret settings for ffmpeg-worker on the Mac mini. Loaded after Infisical's secrets, so these
# win. REDIS_URL (sol's Redis, as redis.wuguishifu.dev) and the S3 settings come from Infisical.
# $SERVICE_DATA is ~/.homelab/services/ffmpeg-worker/data.
ENVIRONMENT=production

FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Each job downloads, encodes and uploads in a dir under here, deleted when it ends.
FFMPEG_WORK_DIR=$SERVICE_DATA/work
# Jobs at once. The M4's media engine handles a few VideoToolbox encodes in parallel.
FFMPEG_CONCURRENCY=2
# The worker refuses to start if Homebrew's ffmpeg is ever built without these.
FFMPEG_REQUIRED_ENCODERS=h264_videotoolbox,hevc_videotoolbox
