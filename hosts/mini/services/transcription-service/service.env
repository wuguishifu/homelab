# Host-side settings for this service (not passed to the app).

# Secrets: universe project, prod, /platform/transcription/service (API_TOKEN).
INFISICAL_DOMAIN=https://infisical.wuguishifu.dev
INFISICAL_PROJECT_ID=49f61399-1e0e-419e-984d-1115793c8e29
INFISICAL_ENV=prod
INFISICAL_PATH=/platform/transcription/service

# Seconds launchd waits after SIGTERM before killing it; the service finishes its current job.
EXIT_TIMEOUT=300

# Hugging Face commit that models.txt's checksums belong to (used by pre-start.sh).
HF_REVISION=5359861c739e955e79d9a303bcbc70fb988958b1
