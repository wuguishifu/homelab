# Non-secret settings for transcription-worker on the Mac mini. Loaded after Infisical's secrets,
# so these win. REDIS_URL (sol's Redis, as redis.wuguishifu.dev) and the S3 settings come from
# Infisical.
# $SERVICE_DATA is ~/.homelab/services/transcription-worker/data.
ENVIRONMENT=production

FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
WHISPER_MODELS_DIR=$SERVICE_DATA/models
# Jobs may request these; the first is the default. Every entry must be in models.txt.
# Benchmarked on this mini (M4, Metal, Sep 2026) for a 3s clip: base.en-q8_0 0.19s,
# small.en-q8_0 0.36s, large-v3-turbo-q8_0 1.2s.
WHISPER_MODELS=small.en-q8_0,base.en-q8_0,large-v3-turbo-q8_0
