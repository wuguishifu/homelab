# Host-side settings for this service (not passed to the app).

# Secrets: universe project, prod. Space-separated Infisical paths, matching the worker's
# secretsPaths in universe; a key in a later path wins over the same key in an earlier one.
INFISICAL_DOMAIN=https://infisical.wuguishifu.dev
INFISICAL_PROJECT_ID=49f61399-1e0e-419e-984d-1115793c8e29
INFISICAL_ENV=prod
INFISICAL_PATHS="/platform/redis /platform/s3"

# Seconds launchd waits after SIGTERM before killing it; the worker finishes its current job.
EXIT_TIMEOUT=300

# Hugging Face commit that models.txt's checksums belong to (used by pre-start.sh).
HF_REVISION=5359861c739e955e79d9a303bcbc70fb988958b1
